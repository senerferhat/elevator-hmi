#!/bin/sh
# Switch the on-glass HMI layout without rebuilding.
#
#   hmi                         show current layout + rotation + wrap
#   hmi portrait                full portrait elevator GUI (800×1280)
#   hmi portrait-video          same GUI with empty video pane on top
#   hmi landscape               full landscape GUI (1280×800, rotated)
#   hmi landscape-video         landscape GUI + empty video pane (rotated)
#   hmi rot 90|270              which way landscape maps onto the portrait panel
#   hmi wrap N                  circular horizontal shift in pixels (52 default;
#                               0 disables). Use if the right edge wraps left.
#
# Aliases (kept from the first demo image):
#   car / vertical              → portrait
#   video / vertical-video      → portrait-video
#
# Persists in /etc/elevator-hmi.layout, /etc/elevator-hmi.rotation and
# /etc/elevator-hmi.wrap so the sysvinit script starts the same variant
# after reboot.

LAYOUT_FILE=/etc/elevator-hmi.layout
ROT_FILE=/etc/elevator-hmi.rotation
WRAP_FILE=/etc/elevator-hmi.wrap
INIT=/etc/init.d/elevator-hmi

current_layout() {
    if [ -r "$LAYOUT_FILE" ]; then
        cat "$LAYOUT_FILE"
    else
        echo portrait
    fi
}

current_rot() {
    if [ -r "$ROT_FILE" ]; then
        cat "$ROT_FILE"
    else
        echo 90
    fi
}

current_wrap() {
    if [ -r "$WRAP_FILE" ]; then
        cat "$WRAP_FILE"
    else
        echo 52
    fi
}

canonical_layout() {
    case "$1" in
        car|vertical|portrait) echo portrait ;;
        video|vertical-video|portrait-video) echo portrait-video ;;
        landscape|landscape-car) echo landscape ;;
        landscape-video) echo landscape-video ;;
        *) echo "" ;;
    esac
}

usage() {
    echo "Usage: hmi [portrait|portrait-video|landscape|landscape-video]"
    echo "       hmi rot [90|270]"
    echo "       hmi wrap [N]"
    echo "Aliases: car, vertical, video, vertical-video"
    echo "Current: $(current_layout)  rot=$(current_rot)  wrap=$(current_wrap)"
}

restart_hmi() {
    if [ -x "$INIT" ]; then
        "$INIT" restart
    else
        echo "init script missing; start manually: elevator-hmi $(current_layout) --rot=$(current_rot) --wrap=$(current_wrap)"
        exit 1
    fi
}

case "${1:-}" in
    "")
        usage
        exit 0
        ;;
    -h|--help)
        usage
        exit 0
        ;;
    rot|rotation)
        case "${2:-}" in
            90|270)
                echo "$2" > "$ROT_FILE"
                echo "rotation $2 (saved $ROT_FILE)"
                restart_hmi
                ;;
            "")
                echo "rotation $(current_rot) (file $ROT_FILE)"
                ;;
            *)
                echo "unknown rotation: $2 (use 90 or 270)"
                exit 2
                ;;
        esac
        ;;
    wrap)
        case "${2:-}" in
            "")
                echo "wrap $(current_wrap) (file $WRAP_FILE)"
                ;;
            -*|0|[1-9]*)
                echo "$2" > "$WRAP_FILE"
                echo "wrap $2 (saved $WRAP_FILE)"
                restart_hmi
                ;;
            *)
                echo "unknown wrap: $2 (pixels, integer; 0 disables)"
                exit 2
                ;;
        esac
        ;;
    *)
        CANON=$(canonical_layout "$1")
        if [ -z "$CANON" ]; then
            echo "unknown layout: $1"
            usage
            exit 2
        fi
        echo "$CANON" > "$LAYOUT_FILE"
        echo "layout $CANON (saved $LAYOUT_FILE) rot=$(current_rot) wrap=$(current_wrap)"
        restart_hmi
        ;;
esac
