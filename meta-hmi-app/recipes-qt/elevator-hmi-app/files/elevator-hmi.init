#!/bin/sh
### BEGIN INIT INFO
# Provides:          elevator-hmi
# Required-Start:    $local_fs
# Required-Stop:     $local_fs
# Default-Start:     5
# Default-Stop:      0 1 6
# Short-Description: Elevator HMI Qt 6 / EGLFS application
# Description:       Starts the single-application Qt Quick HMI on the DSI panel
#                    via EGLFS/KMS. There is no window manager and no display
#                    server by design (CLAUDE.md §8).
### END INIT INFO
#
# sysvinit script: this distro runs sysvinit, not systemd (poky.conf default;
# INIT_MANAGER is unset). /etc/environment.d is therefore inert and
# /etc/profile.d only applies to login shells, so this script MUST export the
# Qt environment itself.

DAEMON=/usr/bin/elevator-hmi
NAME=elevator-hmi
PIDFILE=/var/run/${NAME}.pid
LOGFILE=/var/log/${NAME}.log

# PLATFORM: EGLFS + Mali. Restored 2026-08-22 after BLK-015 was RESOLVED.
#
# BLK-015 was the DSI panel sitting on VP1, which cannot latch plane updates on
# this board. With the panel moved to VP0 (see the BLK-015 block in
# meta-hmi-platform/.../elevator-hmi-boardcon-em3566-v3.dts) KMS scanout works:
# `modetest -M rockchip -s 191:800x1280` shows a stable colour grid on glass.
# That removes the reason for the linuxfb + software-rendering detour and puts
# us back on ADR-001 (EGLFS, Mali-G52), which is also the prerequisite for
# zero-copy VPU video.
#
# FALLBACK if the HMI does not paint: the software path still works and is one
# edit away -- swap the two eglfs lines below for:
#     export QT_QPA_PLATFORM=linuxfb
#     export QT_QUICK_BACKEND=software
# and re-flash. Before doing that, run the cheap kill test first:
#     modetest -M rockchip -s <connector>@<crtc>:800x1280
# a stable pattern means KMS is fine and the fault is in Qt's configuration,
# not in scanout.
export QT_QPA_PLATFORM=eglfs
export QT_QPA_EGLFS_INTEGRATION=eglfs_kms
export QT_QPA_EGLFS_HIDECURSOR=1

# Qt wants XDG_RUNTIME_DIR; without it Qt warns and falls back to /tmp.
export XDG_RUNTIME_DIR=/run/user/0

# Layout persisted by `hmi`. Default is the full portrait GUI. Old images
# wrote `car`/`video`; map those so a previously-flashed /etc file still works.
LAYOUT_FILE=/etc/elevator-hmi.layout
ROT_FILE=/etc/elevator-hmi.rotation
WRAP_FILE=/etc/elevator-hmi.wrap
LAYOUT=portrait
ROT=90
WRAP=52
if [ -r "$LAYOUT_FILE" ]; then
    LAYOUT=$(cat "$LAYOUT_FILE")
fi
case "$LAYOUT" in
    car|vertical) LAYOUT=portrait ;;
    video|vertical-video) LAYOUT=portrait-video ;;
    portrait|portrait-video|landscape|landscape-video) ;;
    simple|full|landscape-simple|landscape-full) ;;
    *) LAYOUT=portrait ;;
esac
if [ -r "$ROT_FILE" ]; then
    ROT=$(cat "$ROT_FILE")
fi
case "$ROT" in
    90|270) ;;
    *) ROT=90 ;;
esac
if [ -r "$WRAP_FILE" ]; then
    WRAP=$(cat "$WRAP_FILE")
fi
case "$WRAP" in
    -*|0|[1-9]*) ;;
    *) WRAP=52 ;;
esac

case "$1" in
    start)
        echo -n "Starting ${NAME}: "
        mkdir -p "${XDG_RUNTIME_DIR}"
        chmod 0700 "${XDG_RUNTIME_DIR}"
        # The framebuffer console (CONFIG_FRAMEBUFFER_CONSOLE) draws into the
        # SAME /dev/fb0 that linuxfb renders into, so it will repaint the login
        # prompt and cursor straight over the HMI. Unbind it before starting.
        # (Under the old EGLFS config this was only a theoretical contention;
        # with linuxfb it is a guaranteed conflict.) Kept non-fatal: on a kernel
        # without fbcon the node simply does not exist.
        if [ -w /sys/class/vtconsole/vtcon1/bind ]; then
            echo 0 > /sys/class/vtconsole/vtcon1/bind 2>/dev/null || true
        fi
        start-stop-daemon --start --background --make-pidfile \
            --pidfile "${PIDFILE}" --startas /bin/sh -- \
            -c "exec ${DAEMON} ${LAYOUT} --rot=${ROT} --wrap=${WRAP} >> ${LOGFILE} 2>&1"
        # --background forks and returns success as soon as the child is
        # spawned, regardless of whether it survives. On 2026-08-18 this printed
        # "OK" for an app that exited immediately (QML load error), which made
        # the failure invisible in the boot log and sent us looking at the
        # panel. Confirm the process is actually still alive before claiming OK,
        # and put the reason on the console where it will be seen.
        sleep 2
        if [ -f "${PIDFILE}" ] && kill -0 "$(cat "${PIDFILE}")" 2>/dev/null; then
            echo "OK"
        else
            echo "FAILED"
            echo "--- last lines of ${LOGFILE} ---"
            tail -n 20 "${LOGFILE}" 2>/dev/null
            echo "--------------------------------"
            # HMI never painted, so the boot splash would stay forever if
            # fbcon stays unbound. Give the console back for diagnostics.
            if [ -w /sys/class/vtconsole/vtcon1/bind ]; then
                echo 1 > /sys/class/vtconsole/vtcon1/bind 2>/dev/null || true
            fi
            exit 1
        fi
        ;;
    stop)
        echo -n "Stopping ${NAME}: "
        start-stop-daemon --stop --pidfile "${PIDFILE}" --retry 5 --oknodo
        rm -f "${PIDFILE}"
        # Give the console back so the panel is usable for diagnostics once the
        # HMI is stopped; otherwise the screen keeps the app's last frame.
        if [ -w /sys/class/vtconsole/vtcon1/bind ]; then
            echo 1 > /sys/class/vtconsole/vtcon1/bind 2>/dev/null || true
        fi
        echo "OK"
        ;;
    restart|force-reload)
        "$0" stop
        sleep 1
        "$0" start
        ;;
    status)
        if [ -f "${PIDFILE}" ] && kill -0 "$(cat "${PIDFILE}")" 2>/dev/null; then
            echo "${NAME} is running (pid $(cat "${PIDFILE}")) layout=${LAYOUT} rot=${ROT} wrap=${WRAP}"
            exit 0
        fi
        echo "${NAME} is not running"
        exit 3
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|force-reload|status}"
        exit 1
        ;;
esac

exit 0
