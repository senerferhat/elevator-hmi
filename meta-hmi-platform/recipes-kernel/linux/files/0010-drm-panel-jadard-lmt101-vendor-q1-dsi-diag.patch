From: Elevator HMI meta-hmi-platform
Subject: [PATCH] drm: panel: jadard — LMT101 vendor Q1 reset, DSI diag, DCS read

- XRES: vendor Q1 pad waveform (HIGH 5 ms → LOW 10 ms → HIGH 120 ms) with
  GPIO_ACTIVE_LOW gpiod semantics (supersedes patch 0008 two-step pulse).
- enable: log dsi->mode_flags / lanes / format (HS video sanity).
- enable: optional DCS GET_POWER_MODE (0x0A) read after successful LMT101 path.
- Init table 0x80 audit: {0x80,0x03} after 0xE3,0xF8 on page 0 and {0x80,0x3A} on
  page 1 after 0xE0,0x01 preserved in lmt101sx006c_init_cmds[] (0003 / vendor file).

---
diff --git a/drivers/gpu/drm/panel/panel-jadard-jd9365da-h3.c b/drivers/gpu/drm/panel/panel-jadard-jd9365da-h3.c
--- a/drivers/gpu/drm/panel/panel-jadard-jd9365da-h3.c
+++ b/drivers/gpu/drm/panel/panel-jadard-jd9365da-h3.c
@@ -87,6 +87,11 @@
 	int err;
 	int rc = 0;
 
+	dev_info(dev, "jadard: dsi mode_flags=0x%08lx lanes=%u format=%u video=%d burst=%d\n",
+		 (unsigned long)dsi->mode_flags, dsi->lanes, dsi->format,
+		 !!(dsi->mode_flags & MIPI_DSI_MODE_VIDEO),
+		 !!(dsi->mode_flags & MIPI_DSI_MODE_VIDEO_BURST));
+
 	if (desc->enable_seq != JADARD_ENABLE_SEQ_LMT101) {
 		msleep(desc->sleep_mode_delay ? desc->sleep_mode_delay : 10);
 	} else if (desc->sleep_mode_delay) {
@@ -136,6 +141,17 @@
 
 	rc = err < 0 ? err : 0;
 enable_done:
+	if (desc->enable_seq == JADARD_ENABLE_SEQ_LMT101 && rc == 0) {
+		u8 pwr_mode;
+		ssize_t rd;
+
+		rd = mipi_dsi_dcs_read(dsi, 0x0a, &pwr_mode, 1);
+		if (rd < 0)
+			dev_info(dev, "jadard: DCS read 0x0A (GET_POWER_MODE) failed: %zd\n", rd);
+		else
+			dev_info(dev, "jadard: GET_POWER_MODE(0x0A)=0x%02x\n", pwr_mode);
+	}
+
 	dev_info(dev, "jadard: init table: %u cmds, rc=%d\n",
 		 desc->num_init_cmds, rc);
 	return rc;
@@ -178,9 +194,16 @@
 	msleep(10);
 
 	if (jadard->reset) {
+		/*
+		 * Vendor Q1 (GPIO_ACTIVE_LOW): XRES high 5 ms → low 10 ms → high 120 ms.
+		 * gpiod 0 = inactive = pad high; gpiod 1 = active = pad low.
+		 */
+		gpiod_set_value(jadard->reset, 0);
+		msleep(5);
+
 		dev_info(panel->dev, "jadard: XRES assert\n");
 		gpiod_set_value(jadard->reset, 1);
-		msleep(20); /* vendor Q1: XRES active-low, 20 ms pulse */
+		msleep(10);
 
 		dev_info(panel->dev, "jadard: XRES release\n");
 		gpiod_set_value(jadard->reset, 0);
