From: Elevator HMI meta-hmi-platform
Subject: [PATCH] drm: panel: jadard — bring-up trace (probe/prepare/enable)

Diagnostic-only dev_info: reset GPIO at probe, XRES assert/release at prepare,
init table count at enable, SLPOUT (0x11) and DISON (0x29) after vendor table.
Remove before production.

---
diff --git a/drivers/gpu/drm/panel/panel-jadard-jd9365da-h3.c b/drivers/gpu/drm/panel/panel-jadard-jd9365da-h3.c
--- a/drivers/gpu/drm/panel/panel-jadard-jd9365da-h3.c
+++ b/drivers/gpu/drm/panel/panel-jadard-jd9365da-h3.c
@@ -85,6 +85,7 @@
 	const struct jadard_panel_desc *desc = jadard->desc;
 	struct mipi_dsi_device *dsi = jadard->dsi;
 	int err;
+	int rc = 0;
 
 	if (desc->enable_seq != JADARD_ENABLE_SEQ_LMT101) {
 		msleep(desc->sleep_mode_delay ? desc->sleep_mode_delay : 10);
@@ -100,20 +101,27 @@
 		err = mipi_dsi_dcs_exit_sleep_mode(dsi);
 		if (err < 0)
 			DRM_DEV_ERROR(dev, "failed to exit sleep mode ret = %d\n", err);
+		else
+			dev_info(dev, "jadard: SLPOUT sent\n");
 
 		msleep(desc->display_init_delay ? desc->display_init_delay : 120);
 
 		err = mipi_dsi_dcs_write_buffer(dsi, e0_page0, JD9365DA_INIT_CMD_LEN);
-		if (err < 0)
-			return err;
+		if (err < 0) {
+			rc = err;
+			goto enable_done;
+		}
 
 		err = mipi_dsi_dcs_set_display_on(dsi);
 		if (err < 0)
 			DRM_DEV_ERROR(dev, "failed to set display on ret = %d\n", err);
+		else
+			dev_info(dev, "jadard: DISON sent\n");
 
 		if (desc->display_on_delay)
 			msleep(desc->display_on_delay);
-		return 0;
+		rc = err < 0 ? err : 0;
+		goto enable_done;
 	}
 
 	msleep(120);
@@ -126,7 +134,11 @@
 	if (err < 0)
 		DRM_DEV_ERROR(dev, "failed to set display on ret = %d\n", err);
 
-	return 0;
+	rc = err < 0 ? err : 0;
+enable_done:
+	dev_info(dev, "jadard: init table: %u cmds, rc=%d\n",
+		 desc->num_init_cmds, rc);
+	return rc;
 }
 
 static int jadard_disable(struct drm_panel *panel)
@@ -166,9 +178,11 @@
 	msleep(10);
 
 	if (jadard->reset) {
+		dev_info(panel->dev, "jadard: XRES assert\n");
 		gpiod_set_value(jadard->reset, 1);
 		msleep(20); /* vendor Q1: XRES active-low, 20 ms pulse */
 
+		dev_info(panel->dev, "jadard: XRES release\n");
 		gpiod_set_value(jadard->reset, 0);
 		msleep(jadard->desc->post_reset_delay ?
 		       jadard->desc->post_reset_delay : 5);
@@ -708,6 +722,11 @@
 	jadard->reset = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_LOW);
 	if (IS_ERR(jadard->reset))
 		return PTR_ERR(jadard->reset);
+	if (jadard->reset)
+		dev_info(dev, "jadard: reset gpio = gpio-%d\n",
+			 desc_to_gpio(jadard->reset));
+	else
+		dev_info(dev, "jadard: reset gpio = ABSENT\n");
 
 	jadard->vdd = devm_regulator_get(dev, "vdd");
 	if (IS_ERR(jadard->vdd)) {
