@@ -21,6 +21,13 @@
 
 #define JD9365DA_INIT_CMD_LEN		2
 
+/*
+ * library/LMT101/LMT101SX006C initial codes.txt — tail after register block:
+ * 0x11 (sleep out), 120 ms, 0xE0/0x00, 0x29 (display on), 5 ms.
+ */
+#define JADARD_ENABLE_SEQ_DEFAULT	0
+#define JADARD_ENABLE_SEQ_LMT101	1
+
 struct jadard_init_cmd {
 	u8 data[JD9365DA_INIT_CMD_LEN];
 };
@@ -31,6 +38,7 @@
 	enum mipi_dsi_pixel_format format;
 	const struct jadard_init_cmd *init_cmds;
 	u32 num_init_cmds;
+	unsigned int enable_seq;
 };
 
 struct jadard {
@@ -57,7 +65,8 @@
 	unsigned int i;
 	int err;
 
-	msleep(10);
+	if (desc->enable_seq != JADARD_ENABLE_SEQ_LMT101)
+		msleep(10);
 
 	for (i = 0; i < desc->num_init_cmds; i++) {
 		const struct jadard_init_cmd *cmd = &desc->init_cmds[i];
@@ -67,6 +76,27 @@
 			return err;
 	}
 
+	if (desc->enable_seq == JADARD_ENABLE_SEQ_LMT101) {
+		u8 e0_page0[JD9365DA_INIT_CMD_LEN] = { 0xE0, 0x00 };
+
+		err = mipi_dsi_dcs_exit_sleep_mode(dsi);
+		if (err < 0)
+			DRM_DEV_ERROR(dev, "failed to exit sleep mode ret = %d\n", err);
+
+		msleep(120);
+
+		err = mipi_dsi_dcs_write_buffer(dsi, e0_page0, JD9365DA_INIT_CMD_LEN);
+		if (err < 0)
+			return err;
+
+		err = mipi_dsi_dcs_set_display_on(dsi);
+		if (err < 0)
+			DRM_DEV_ERROR(dev, "failed to set display on ret = %d\n", err);
+
+		msleep(5);
+		return 0;
+	}
+
 	msleep(120);
 
 	err = mipi_dsi_dcs_exit_sleep_mode(dsi);
@@ -393,6 +423,7 @@
 	.format = MIPI_DSI_FMT_RGB888,
 	.init_cmds = cz101b4001_init_cmds,
 	.num_init_cmds = ARRAY_SIZE(cz101b4001_init_cmds),
