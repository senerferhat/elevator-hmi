// SPDX-License-Identifier: (GPL-2.0 OR MIT)
/*
 * Elevator HMI — Boardcon EM3566 v3 reference + LMT101SX006C (JD9365) on MIPI-DSI0.
 *
 * Extends the Rockchip BSP baseline:
 *   arch/arm64/boot/dts/rockchip/rk3566-evb2-lp4x-v10-linux.dts
 * from the linux-rockchip_6.1 kernel (SRCREV in meta-rockchip linux-rockchip_6.1.bb
 * at the kas-pinned commit).
 *
 * Panel overlay: elevator-hmi-lmt101sx006c-panel.dtsi (replaces stock EVB
 * simple-panel-dsi child under &dsi0).
 */

/dts-v1/;

#include "rk3566-evb2-lp4x-v10-linux.dts"
#include "elevator-hmi-lmt101sx006c-panel.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/rockchip.h>

/*
 * TASK-120 / TASK-119 / TASK-133: CM3566 has no functioning RK809 at 0x20 on this bring-up.
 * rk3568-evb.dtsi still defines PMIC regulators — delete the nodes we replace with board
 * `regulator-fixed` rails. **TASK-133:** restore **`/delete-node/ LDO_REG7`** so
 * **`vcca_1v8`** is never bound to a ghost PMIC rail (fixes DSI **`-517`** defer loops
 * seen after TASK-130). Board-scope **`vcca_1v8`** below matches TASK-129.
 */
&rk809 {
	regulators {
		/delete-node/ DCDC_REG1;
		/delete-node/ DCDC_REG2;
		/delete-node/ DCDC_REG4;
		/delete-node/ LDO_REG5;
		/delete-node/ LDO_REG7;
	};
};

/*
 * TASK-117: rk3568-linux.dtsi hardcodes root=PARTUUID=614e0000-0000; WIC rootfs is
 * /dev/mmcblk0p2. Override chosen.bootargs in this board DTB (kernel uses DT chosen).
 */
/ {
	chosen {
		bootargs = "earlycon=uart8250,mmio32,0xfe660000 console=ttyFIQ0 console=ttyS2,1500000 root=/dev/mmcblk0p2 rw rootfstype=ext4 rootwait";
	};

	/* TASK-119: CM3566 — pmu_io_domains cannot use PMIC supplies. */
	vcc_3v3_fixed: regulator-vcc3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_3v3_fixed";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};

	vcc_1v8_fixed: regulator-vcc1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_1v8_fixed";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};

	/* TASK-120: replace PMIC rails inherited from rk3568-evb (see &rk809 delete-node). */
	vdd_logic: regulator-vdd-logic {
		compatible = "regulator-fixed";
		regulator-name = "vdd_logic";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <900000>;
		regulator-max-microvolt = <900000>;
	};

	vdd_gpu: regulator-vdd-gpu {
		compatible = "regulator-fixed";
		regulator-name = "vdd_gpu";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <900000>;
		regulator-max-microvolt = <900000>;
	};

	vdd_npu: regulator-vdd-npu {
		compatible = "regulator-fixed";
		regulator-name = "vdd_npu";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <900000>;
		regulator-max-microvolt = <900000>;
	};

	vccio_sd: regulator-vccio-sd {
		compatible = "regulator-fixed";
		regulator-name = "vccio_sd";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};

	/* TASK-133: 1.8 V analog / DSI PHY rail — board fixed; PMIC LDO_REG7 deleted above. */
	vcca_1v8: regulator-vcca-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vcca_1v8";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};
};

&pmu_io_domains {
	status = "okay";
	pmuio1-supply = <&vcc_3v3_fixed>;
	pmuio2-supply = <&vcc_3v3_fixed>;
	vccio1-supply = <&vcc_1v8_fixed>;
	vccio2-supply = <&vcc_1v8_fixed>;
	vccio3-supply = <&vcc_3v3_fixed>;
	vccio4-supply = <&vcc_1v8_fixed>;
	vccio5-supply = <&vcc_3v3_fixed>;
	vccio6-supply = <&vcc_3v3_fixed>;
	vccio7-supply = <&vcc_3v3_fixed>;
};

&vop {
	vop-supply = <&vdd_logic>;
};

&gpu {
	mali-supply = <&vdd_gpu>;
};

&rknpu {
	rknpu-supply = <&vdd_npu>;
};

&rkvenc {
	venc-supply = <&vdd_logic>;
};

&rkvdec {
	vdec-supply = <&vdd_logic>;
};

&dmc {
	center-supply = <&vdd_logic>;
};

/*
 * SD / TF card slot — sdmmc0 is fe2b0000 on RK3566 (fe2c0000 is sdmmc1/SDIO).
 *
 * rk3568-evb.dtsi wires vmmc-supply to the RK809 PMIC rail vcc3v3_sd
 * (SWITCH_REG2). This board has NO functioning RK809 at 0x20 (see the &rk809
 * deletions at the top of this file), so that regulator never appears and the
 * controller sits in "deferred probe pending" forever:
 *     platform fe2b0000.mmc: deferred probe pending
 * The slot is silent, /dev/mmcblk1 never appears, and the HMI video pane shows
 * NO CARD no matter what is inserted. Point vmmc at the board's fixed 3.3 V
 * rail instead. (vqmmc/vccio_sd is already a board regulator-fixed.)
 *
 * sd-uhs-sdr104 is deleted with it: UHS SDR104 requires switching vqmmc from
 * 3.3 V down to 1.8 V, and vccio_sd here is a FIXED 3.3 V supply that cannot.
 * Leaving it advertised makes the core attempt a voltage switch that cannot
 * succeed. High-speed (50 MHz, ~25 MB/s) remains, which is ~20x what the
 * ~1.2 MB/s MJPEG demo clip needs.
 */
&sdmmc0 {
	vmmc-supply = <&vcc_3v3_fixed>;
	vqmmc-supply = <&vccio_sd>;
	/delete-property/ sd-uhs-sdr104;
};

&saradc {
	vref-supply = <&vcca_1v8>;
};

/*
 * EM3566 v3 VCC3V3_LCD (CON1 pins 5/6): PWM0_M0 → R457 → Q18 (NPN) → Q17 (P-MOSFET).
 * SoM pin 140 / GPIO0_B7 — logic HIGH turns the rail ON (not RK_EVB GPIO0_C7).
 * No pinctrl-0 here (gpiod muxes the line); pinctrl on regulator-fixed provoked
 * DSI/panel **-517** defer storms with backlight **power-supply** (TASK-131 class).
 * Omit vin-supply on this node.
 */
&vcc3v3_lcd0_n {
	status = "okay";
	gpio = <&gpio0 RK_PB7 GPIO_ACTIVE_HIGH>;
	enable-active-high;
	regulator-always-on;
	regulator-boot-on;
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;
};

/* BSP rk3566-evb2 repurposes RK_PB7 as work_led — conflicts with PWM0_M0 LCD rail. */
&work_led {
	status = "disabled";
};

/*
 * Panel XRES: gpio0 RK_PC6 (TOUCH_RST, CON1 pin 11, gpiochip0 line 22).
 * SPI0_CS0_M0 shares PC6 — disable SPI0 so jadard owns the reset line.
 * VCC3V3_LCD switch: RK_PB7 (PWM0_M0), not PC7. `gt1x` off.
 */
&spi0 {
	status = "disabled";
};

&gt1x {
	status = "disabled";
};

/*
 * TASK-141: XRES (gpio0 RK_PC6, CON1 pin 11) scope finding — the release edge
 * could not pull the line back HIGH into the *connected* panel load, while it
 * toggled cleanly with the panel disconnected. With spi0/gt1x disabled, PC6
 * reverts to its reset-default pad config (weakest drive strength), which is
 * too weak to win against the panel/harness reset net. Force GPIO function with
 * MAX drive strength (level 15) + pull-up so the SoC actively drives XRES high.
 * The jadard driver still owns the line via gpiod (reset-gpios in the panel
 * dtsi); pinctrl only fixes the pad electrical config, not ownership.
 */
&pinctrl {
	lcd {
		lcd_rst_pin: lcd-rst-pin {
			rockchip,pins = <0 RK_PC6 RK_FUNC_GPIO &pcfg_pull_up_drv_level_15>;
		};
	};
};

/*
 * Omit power-supply on pwm-backlight — linking to vcc3v3_lcd0_n caused panel/DSI
 * **-517** defer/rebind loops on EM3566 v3 (same class as TASK-131 vin-supply).
 * Dummy regulator warning in dmesg is acceptable for bring-up.
 */
&backlight {
	/delete-property/ power-supply;
};

&backlight1 {
	/delete-property/ power-supply;
};

/*
 * BLK-015 — move the DSI panel from Video Port 1 to Video Port 0.
 *
 * WHY: we inherit the Rockchip EVB's video-port assignment, which hands VP0 to
 * HDMI and pushes the DSI panel onto VP1:
 *     rk3566-evb2-lp4x-v10.dtsi:190  &dsi0_in_vp0 { status = "disabled"; };
 *     rk3566-evb2-lp4x-v10.dtsi:194  &dsi0_in_vp1 { status = "okay";     };
 *     rk3566-evb2-lp4x-v10.dtsi:541  &route_dsi0  { connect = <&vp1_out_dsi0>; };
 *     rk3568-evb.dtsi:1077           &hdmi_in_vp0 { status = "okay";     };
 * That is right for the EVB, which ships an HDMI display. It is wrong for this
 * product, which has no HDMI at all and only the LMT101 on DSI0.
 *
 * Boardcon's OWN device tree for this board does the opposite. Decompiled from
 * their shipped image (library/EM3566/Linux6.1/Image/update-buildroot-lvds.img):
 *     VP0 = dsi0, dsi1, edp
 *     VP1 = hdmi, lvds
 *
 * And VP1 is exactly where BLK-015 lives: plane commits are accepted, page
 * flips complete at 60 Hz, the vop2 driver logs the correct scanout address
 * every frame — and the hardware never latches it. Only writes into the buffer
 * latched at boot reach the glass. modetest with a plain dumb buffer fails
 * identically to Qt, so it is below all of our userspace.
 *
 * This has NOT yet been confirmed to fix BLK-015 — the board was powered off
 * when this was written. It is a single-variable change with a cheap kill test:
 *     modetest -M rockchip -s <connector>@<crtc>:800x1280
 * If a test pattern appears on glass, KMS scanout works and the whole linuxfb /
 * software-decode detour can be unwound (EGLFS + Mali + VPU video).
 *
 * HDMI is moved to VP1 rather than deleted, mirroring the vendor. It costs
 * nothing on a product with no HDMI connector, and it keeps the port usable as
 * a diagnostic: if VP1 turns out to be broken for HDMI too, that is a strong
 * signal to take to Boardcon/Rockchip.
 */
&dsi0_in_vp0 {
	status = "okay";
};

&dsi0_in_vp1 {
	status = "disabled";
};

&route_dsi0 {
	status = "okay";
	connect = <&vp0_out_dsi0>;
};

&hdmi_in_vp0 {
	status = "disabled";
};

&hdmi_in_vp1 {
	status = "okay";
};

&route_hdmi {
	connect = <&vp1_out_hdmi>;
};
