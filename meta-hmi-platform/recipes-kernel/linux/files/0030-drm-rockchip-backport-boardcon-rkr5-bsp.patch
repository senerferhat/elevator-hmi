+	    address < vop->res->end) {
+		regs = vop->regs;
+		offset = address - vop->res->start;
+	} else if (vop->lut_res && address >= vop->lut_res->start &&
+		   address < vop->lut_res->end) {
+		regs = vop->lut_regs;
+		offset = address - vop->lut_res->start;
+	} else {
+		DRM_ERROR("unsupported address: %pa\n", &address);
+		return -ENXIO;
+	}
+	writel(val, regs + offset);
+
+	return 0;
