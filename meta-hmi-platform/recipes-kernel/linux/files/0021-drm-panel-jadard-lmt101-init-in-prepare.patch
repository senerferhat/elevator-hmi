From: Elevator HMI meta-hmi-platform
Subject: [PATCH] drm: panel: jadard - LMT101 send vendor init in prepare() (command mode, pre-video)

ROOT-CAUSE CANDIDATE (2026-07-23 full-stack audit): on this Rockchip vendor
kernel, dw_mipi_dsi_bridge_atomic_pre_enable() brings the host up in COMMAND
mode and calls drm_panel_prepare(); dw_mipi_dsi_bridge_atomic_enable() then
switches the host to VIDEO mode (VOP already streaming) BEFORE calling
drm_panel_enable(). Our backported mainline-style jadard driver sends the
entire vendor bring-up (196-cmd init table, page-4 clock fix, SLPOUT, DISON)
from enable() - i.e. as HS commands in the blanking of an already-running
video stream; the panel receives video packets before it is initialized.
The vendor fixture (MediaTek LCM flow) completes init in command mode before
video starts; Rockchip's own simple-panel-dsi sends its init from prepare()
for exactly this reason.

Fix: send the full vendor command bring-up at the end of jadard_prepare()
(host still in command mode, no video). enable() keeps the DIAG15
diagnostics / TE path and skips init/SLPOUT/DISON when prepare() already
sent them (jadard->init_sent). Sentinel:
"jadard: INIT-IN-PREPARE (cmd-mode, pre-video)".

Kill test: pattern/fbcon visible or 0x45 scanline non-zero => ordering was
the root cause. Unchanged backlit black + 0x45=0x00 => ordering exonerated.

---
--- a/drivers/gpu/drm/panel/panel-jadard-jd9365da-h3.c
+++ b/drivers/gpu/drm/panel/panel-jadard-jd9365da-h3.c
@@ -56,6 +56,7 @@
 	struct regulator *vdd;
 	struct regulator *vccio;
 	struct gpio_desc *reset;
+	bool init_sent;
 };
 
 static inline struct jadard *panel_to_jadard(struct drm_panel *panel)
@@ -104,13 +105,81 @@
 }
 
 
+
+/*
+ * INIT-IN-PREPARE (2026-07-23): send the full vendor command bring-up while
+ * the DSI host is still in COMMAND mode and no video is streaming. On this
+ * vendor kernel the dsi bridge switches to VIDEO mode at atomic_enable
+ * BEFORE drm_panel_enable() runs, so anything sent from jadard_enable() is
+ * transmitted during the blanking of a live video stream and the panel
+ * receives HS video packets before init/SLPOUT. drm_panel_prepare() is
+ * called from the bridge's pre_enable, where the host is explicitly in
+ * command mode ("Switch to cmd mode for panel-bridge pre_enable & panel
+ * prepare" in dw-mipi-dsi.c) - the fixture-equivalent place for the vendor
+ * sequence on this stack.
+ */
+static void jadard_poweron_cmd_sequence(struct jadard *jadard)
+{
+	const struct jadard_panel_desc *desc = jadard->desc;
+	struct mipi_dsi_device *dsi = jadard->dsi;
+	struct device *dev = &dsi->dev;
+	u8 e0_page0[JD9365DA_INIT_CMD_LEN] = { 0xE0, 0x00 };
+	int err;
+
+	dev_info(dev, "jadard: INIT-IN-PREPARE (cmd-mode, pre-video)\n");
+
+	jadard_init_sequence(jadard);
+
+	if (desc->enable_seq == JADARD_ENABLE_SEQ_LMT101_FAE_CLOCK) {
+		static const u8 fae_clock[][JD9365DA_INIT_CMD_LEN] = {
+			{ 0xE0, 0x04 },
+			{ 0x37, 0x58 },
+			{ 0x35, 0x08 },
+			{ 0x36, 0x49 },
+			{ 0x2C, 0x06 },
+			{ 0xE0, 0x00 },
+		};
+		unsigned int j;
+
+		dev_info(dev, "jadard: FAE page-4 clock fix (pre-SLPOUT)\n");
+		for (j = 0; j < ARRAY_SIZE(fae_clock); j++) {
+			if (jadard_generic_reg_val(dsi, dev, fae_clock[j][0],
+						   fae_clock[j][1]) < 0)
+				return;
+		}
+	}
+
+	err = mipi_dsi_dcs_exit_sleep_mode(dsi);
+	if (err < 0)
+		dev_err(dev, "failed to exit sleep mode ret = %d\n", err);
+	else
+		dev_info(dev, "jadard: SLPOUT sent\n");
+
+	msleep(desc->display_init_delay ? desc->display_init_delay : 120);
+
+	err = mipi_dsi_dcs_write_buffer(dsi, e0_page0, JD9365DA_INIT_CMD_LEN);
+	if (err < 0)
+		return;
+
+	err = mipi_dsi_dcs_set_display_on(dsi);
+	if (err < 0)
+		dev_err(dev, "failed to set display on ret = %d\n", err);
+	else
+		dev_info(dev, "jadard: DISON sent\n");
+
+	if (desc->display_on_delay)
+		msleep(desc->display_on_delay);
+
+	jadard->init_sent = true;
+}
+
 static int jadard_enable(struct drm_panel *panel)
 {
 	struct device *dev = panel->dev;
 	struct jadard *jadard = panel_to_jadard(panel);
 	const struct jadard_panel_desc *desc = jadard->desc;
 	struct mipi_dsi_device *dsi = jadard->dsi;
-	int err;
+	int err = 0;
 	int rc = 0;
 
 	dev_info(dev, "jadard: dsi mode_flags=0x%08lx lanes=%u format=%u video=%d burst=%d\n",
@@ -124,12 +193,14 @@
 		msleep(desc->sleep_mode_delay);
 	}
 
-	jadard_init_sequence(jadard);
+	if (!jadard->init_sent)
+		jadard_init_sequence(jadard);
 
 	if (jadard_is_lmt101_enable_seq(desc->enable_seq)) {
 		u8 e0_page0[JD9365DA_INIT_CMD_LEN] = { 0xE0, 0x00 };
 
-		if (desc->enable_seq == JADARD_ENABLE_SEQ_LMT101_FAE_CLOCK) {
+		if (desc->enable_seq == JADARD_ENABLE_SEQ_LMT101_FAE_CLOCK &&
+		    !jadard->init_sent) {
 			static const u8 fae_clock[][JD9365DA_INIT_CMD_LEN] = {
 				{ 0xE0, 0x04 },
 				{ 0x37, 0x58 },
@@ -153,25 +224,29 @@
 		}
 
 
-		err = mipi_dsi_dcs_exit_sleep_mode(dsi);
-		if (err < 0)
-			DRM_DEV_ERROR(dev, "failed to exit sleep mode ret = %d\n", err);
-		else
-			dev_info(dev, "jadard: SLPOUT sent\n");
+		if (!jadard->init_sent) {
+			err = mipi_dsi_dcs_exit_sleep_mode(dsi);
+			if (err < 0)
+				DRM_DEV_ERROR(dev, "failed to exit sleep mode ret = %d\n", err);
+			else
+				dev_info(dev, "jadard: SLPOUT sent\n");
 
-		msleep(desc->display_init_delay ? desc->display_init_delay : 120);
+			msleep(desc->display_init_delay ? desc->display_init_delay : 120);
 
-		err = mipi_dsi_dcs_write_buffer(dsi, e0_page0, JD9365DA_INIT_CMD_LEN);
-		if (err < 0) {
-			rc = err;
-			goto enable_done;
-		}
+			err = mipi_dsi_dcs_write_buffer(dsi, e0_page0, JD9365DA_INIT_CMD_LEN);
+			if (err < 0) {
+				rc = err;
+				goto enable_done;
+			}
 
-		err = mipi_dsi_dcs_set_display_on(dsi);
-		if (err < 0)
-			DRM_DEV_ERROR(dev, "failed to set display on ret = %d\n", err);
-		else
-			dev_info(dev, "jadard: DISON sent\n");
+			err = mipi_dsi_dcs_set_display_on(dsi);
+			if (err < 0)
+				DRM_DEV_ERROR(dev, "failed to set display on ret = %d\n", err);
+			else
+				dev_info(dev, "jadard: DISON sent\n");
+		} else {
+			dev_info(dev, "jadard: INIT-IN-PREPARE active - enable() diagnostics only\n");
+		}
 
 		if (desc->enable_seq == JADARD_ENABLE_SEQ_LMT101_FAE_CLOCK) {
 			u8 pwr_mode;
@@ -361,6 +436,9 @@
 		msleep(135);
 	}
 
+	if (jadard_is_lmt101_enable_seq(jadard->desc->enable_seq))
+		jadard_poweron_cmd_sequence(jadard);
+
 	return 0;
 }
 
@@ -368,6 +446,8 @@
 {
 	struct jadard *jadard = panel_to_jadard(panel);
 
+	jadard->init_sent = false;
+
 	if (jadard->reset) {
 		gpiod_set_value(jadard->reset, 1);
 		msleep(120);
