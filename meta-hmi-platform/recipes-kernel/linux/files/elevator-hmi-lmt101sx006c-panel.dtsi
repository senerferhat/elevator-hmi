// SPDX-License-Identifier: (GPL-2.0 OR MIT)
/*
 * LMT101SX006C + JD9365DA-H3 (jadard) on RK3566 MIPI-DSI controller **dsi0**.
 *
 * Replaces the stock EVB `simple-panel-dsi` `panel@0` under &dsi0 from
 * rk3568-evb.dtsi (same graph pattern: panel endpoint + &dsi0/ports/port@1).
 *
 * Phandle alignment (BSP tree at linux-rockchip_6.1 SRCREV, files
 * arch/arm64/boot/dts/rockchip/rk3566-evb2-lp4x-v10.dtsi + rk3568-evb.dtsi):
 *   vcc3v3_lcd0_n — VCC3V3_LCD rail; EM3566 v3 enables via PWM0_M0 / GPIO0_B7 (board DTS)
 *   vcca_1v8 — rk809 PMIC LDO in rk3568-evb.dtsi (panel IO / VCCIO)
 *   backlight — pwm-backlight node in rk3568-evb.dtsi
 *
 * In-repo carrier docs (signal names, not alternate phandles):
 *   library/EM3566/Usermanual/EM3566_hardware_manual.md §2.8 CON1
 *   library/EM3566/Schematic/em3566_v3sch.md
 *
 * BLK-006 / TASK-121: reset-gpios on gpio0 RK_PC6 (TOUCH_RST / CON1 pin 11,
 * SoM pin 138) — **gpiochip0 line 22**, **GPIO_ACTIVE_LOW** per vendor Q1.
 * Board DTS disables **&spi0** so SPI0_CS0 does not hold PC6 low. FPC RESET
 * (pin 5) must route to CON1 pin 11. `gt1x` disabled in board DTS.
 * TASK-125: vendor init — **4-lane DSI** (`{0x80,0x03}` CMD_DSI_INT0 bits[1:0]=11; `library/LMT101/LMT101SX006C initial codes.txt`).
 */

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/rockchip.h>

&dsi0 {
	/*
	 * 2026-07-03 single-variable test (session-log entry, same date):
	 *
	 * Confirmed on-target and by reading dw_mipi_dsi_calculate_lane_mpbs()
	 * in dw-mipi-dsi-rockchip.c directly: that function never inspects
	 * mode_flags. Dropping MIPI_DSI_MODE_VIDEO_BURST (patch 0019) has ZERO
	 * effect on the negotiated PHY rate by itself. Without this property,
	 * the driver falls back to pixel_clock * (bpp/lanes) * 10/9 = ~468 Mbps
	 * (verified: "final DSI-Link bandwidth: 468 x 4 Mbps" with burst=0 on
	 * the current tree) -- NOT the vendor's stated PLL_CLOCK=420.
	 *
	 * Reinstating the explicit override to test a new hypothesis: running
	 * non-burst mode at the burst-margin rate (468) rather than the exact
	 * pixel-derived rate (420) may be the proximate cause of the green-
	 * noise/vignetting symptom reported on the no-DT-override build, since
	 * non-burst DSI has no LP-gap slack to absorb an 11%-fast HS rate the
	 * way burst mode does.
	 *
	 * KNOWN RISK (documented before this change, not discovered by it):
	 * this exact property was previously removed ("revert-step-a") because
	 * lane-rate=420 + non-burst caused DCS BTA reads to fail with -110.
	 * Re-adding it may reintroduce that -110 regression and cost DIAG15
	 * register visibility (0x0A/0x0F/0x45) on this build. That is an
	 * accepted tradeoff for this test -- the primary observable is the
	 * glass (does the noise/vignetting change character or disappear at
	 * the vendor-exact rate?), not the diagnostic reads.
	 *
	 * Kill test: flash this build. (a) Flat black + clean reads (matches
	 * original 7dbf72d9 result) -> rate was not the noise's cause, revert
	 * this and look at porches next. (b) Stable/different image -> rate
	 * mismatch confirmed as (at least a) cause. (c) Noise persists at
	 * correct rate -> rate ruled out entirely, look elsewhere.
	 */
	rockchip,lane-rate = <420>;

	/delete-node/ panel@0;

	ports {
		/delete-node/ port@1;

		port@1 {
			reg = <1>;
			dsi_out_panel: endpoint {
				remote-endpoint = <&panel_in_dsi>;
			};
		};
	};

	panel_lmt101: panel@0 {
		compatible = "elevator-hmi,lmt101sx006c", "jadard,jd9365da-h3";
		reg = <0>;
		dsi-lanes = <4>;
		dsi-format = <0>;
		vdd-supply = <&vcc3v3_lcd0_n>;
		vccio-supply = <&vcca_1v8>;
		backlight = <&backlight>;
		reset-gpios = <&gpio0 RK_PC6 GPIO_ACTIVE_LOW>;
		/* TASK-141: max drive + pull-up on XRES (lcd_rst_pin in board DTS). */
		pinctrl-names = "default";
		pinctrl-0 = <&lcd_rst_pin>;

		port {
			panel_in_dsi: endpoint {
				remote-endpoint = <&dsi_out_panel>;
			};
		};
	};
};
